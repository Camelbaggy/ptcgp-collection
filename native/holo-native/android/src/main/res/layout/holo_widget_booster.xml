<?xml version="1.0" encoding="utf-8"?>
<!-- Petit widget 2 × 2 (maquette A) : booster à ouvrir en premier. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/holo_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/holo_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:letterSpacing="0.04"
        android:text="@string/holo_widget_next_short"
        android:textColor="@color/holo_widget_blue"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/holo_w_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/holo_widget_empty_short"
        android:textColor="@color/holo_widget_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/holo_w_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/holo_w_pack"
                android:layout_width="48dp"
                android:layout_height="68dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/holo_widget_pack" />

            <TextView
                android:id="@+id/holo_w_booster"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:maxLines="3"
                android:ellipsize="end"
                android:textColor="@color/holo_widget_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/holo_w_pnew"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/holo_widget_pill"
            android:paddingStart="8dp"
            android:paddingTop="1dp"
            android:paddingEnd="8dp"
            android:paddingBottom="1dp"
            android:maxLines="1"
            android:textColor="@color/holo_widget_ok"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
