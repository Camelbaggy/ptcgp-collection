<?xml version="1.0" encoding="utf-8"?>
<!-- Petit widget 2 × 2 (maquette A) : anneau de complétion. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/holo_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/holo_widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp">

        <ProgressBar
            android:id="@+id/holo_w_ring"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="false"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/holo_widget_ring" />

        <TextView
            android:id="@+id/holo_w_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:maxLines="1"
            android:text="– %"
            android:textColor="@color/holo_widget_text"
            android:textSize="22sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/holo_w_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/holo_widget_empty_short"
        android:textColor="@color/holo_widget_muted"
        android:textSize="12sp" />
</LinearLayout>
