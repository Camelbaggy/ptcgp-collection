<?xml version="1.0" encoding="utf-8"?>
<!-- Mise en page compacte (widget de moins de 250 dp de large) : %, barre, booster conseillé sur une ligne. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/holo_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/holo_widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/holo_w_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/holo_w_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="– %"
            android:textColor="@color/holo_widget_text"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/holo_w_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/holo_widget_progress" />

    <TextView
        android:id="@+id/holo_w_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/holo_widget_empty"
        android:textColor="@color/holo_widget_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/holo_w_booster"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/holo_widget_ok"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
